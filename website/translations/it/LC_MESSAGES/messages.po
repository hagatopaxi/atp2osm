#, python-format
msgid ""
"Your integration went through: <strong>%(count)s POI</strong> enriched in"
" OpenStreetMap."
msgid_plural ""
"Your integration went through: <strong>%(count)s POIs</strong> enriched "
"in OpenStreetMap."
msgstr[0] "Integrazione completata: <strong>%(count)s POI</strong> arricchito in OpenStreetMap."
msgstr[1] "Integrazione completata: <strong>%(count)s POI</strong> arricchiti in OpenStreetMap."

#: website/templates/history_detail.html:22
msgid "Your integration went through: the data has been sent to OpenStreetMap."
msgstr "Integrazione completata: i dati sono stati inviati a OpenStreetMap."

#: website/templates/history_detail.html:24
#: website/templates/history_detail.html:34
msgid "Integrate another brand"
msgstr "Integra un'altra marca"

#: website/templates/history_detail.html:30
#, python-format
msgid ""
"The integration only partly completed: <strong>%(count)s POI</strong> "
"enriched, but some subdivisions could not be integrated."
msgid_plural ""
"The integration only partly completed: <strong>%(count)s POIs</strong> "
"enriched, but some subdivisions could not be integrated."
msgstr[0] "L'integrazione è stata completata solo parzialmente: <strong>%(count)s POI</strong> arricchito, ma non è stato possibile integrare alcune suddivisioni."
msgstr[1] "L'integrazione è stata completata solo parzialmente: <strong>%(count)s POI</strong> arricchiti, ma non è stato possibile integrare alcune suddivisioni."

#: website/templates/history_detail.html:32
msgid ""
"The integration only partly completed: some subdivisions could not be "
"integrated."
msgstr "L'integrazione è stata completata solo parzialmente: non è stato possibile integrare alcune suddivisioni."

#: website/templates/history_detail.html:38
msgid ""
