msgstr "Visualizza in OSM"

#: website/templates/brands/:brand_wikidata/validate.html:302
msgid "Reject"
msgstr "Rifiuta"

#: website/templates/brands/:brand_wikidata/validate.html:307
msgid "Accept"
msgstr "Accetta"

#: website/templates/brands/:brand_wikidata/validate.html:313
msgid "Check the source before accepting."
msgstr "Controlla la fonte prima di accettare."

#: website/templates/brands/:brand_wikidata/validate.html:325
msgid "Go to the next step"
msgstr "Vai al passaggio successivo"

#: website/templates/brands/:brand_wikidata/validate.html:332
