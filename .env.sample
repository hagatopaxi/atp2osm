# Secrets only. Everything else lives in the configuration file, which this
# variable names — see config.schema.json and config.example.json.
ATP2OSM_CONFIG=/etc/atp2osm/config.json

# OSM OAuth2 application, registered on the API this instance talks to
# (the sandbox and the real OSM hold different applications).
OSM_OAUTH_CLIENT_ID=YOUR_CLIENT_ID
OSM_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Signs the session cookie, which carries the OSM token: rotating it logs
# everyone out.
SECRET_KEY=YOUR_SECRET_KEY

# PostGIS password. The rest of the connection is in the configuration file.
OSM_DB_PASSWORD=YOUR_DB_PASSWORD
